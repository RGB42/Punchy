; Engine configuration file.
; Punchy — toy action figures come alive. Godot 4.7, Forward+, Jolt.

config_version=5

[application]

config/name="Punchy"
config/description="Action figures come alive in an ordinary house. Fight and climb your way across the room."
config/version="0.1.0"
run/main_scene="res://scenes/hero_select.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="climb"
3d_physics/layer_6="barrier"
3d_physics/layer_7="boss"

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=24.0
common/physics_ticks_per_second=120

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=2
